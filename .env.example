# ---- secrets - never commit a real .env ----
# Database
DATABASE_URL=postgres://civil:civil_dev_pw_2026@localhost:5433/civil_erp
# Test database (used by vitest)
TEST_DATABASE_URL=postgres://civil:civil_dev_pw_2026@localhost:5433/civil_erp_test

# Auth / session (generate with: openssl rand -base64 48)
AUTH_SECRET=change-me-in-production-openssl-rand-base64-48

# App
NEXT_PUBLIC_APP_NAME=CivilERP
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File storage provider: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
# S3-compatible object storage (used only when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
